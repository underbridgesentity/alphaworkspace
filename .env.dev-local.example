# Local development ONLY. Copy to .env.dev-local (gitignored).
#
# This file is loaded by scripts/with-local-env.ts, which injects every key
# below into the child process BEFORE Next starts. @next/env never overwrites a
# key that is already in the environment, so everything here WINS over
# .env.local for the whole session.
#
# That is deliberate: .env.local holds PRODUCTION credentials (Supabase, live
# PayFast, Resend, Deepgram). Every one of those names is shadowed below with a
# blank or a sandbox value, so a local session cannot charge a live account,
# send a real email, or write to production storage. If you add a new secret to
# .env.local, add its name here too.

# --- Core -----------------------------------------------------------------
# MUST be localhost or 127.0.0.1. The runner refuses to start otherwise.
DATABASE_URL=postgresql://localhost:5432/alphaworkspace_dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=local-development-secret-not-used-anywhere-else
CRON_SECRET=local-cron-secret

# --- Seeded sign-in -------------------------------------------------------
# Gives the seeded demo users this password, so you can sign in locally with
# no Resend round trip. It goes through the ORDINARY production password
# provider, there is no dev auth bypass in this codebase.
# Minimum 10 characters. Unset it and the seed writes no password at all.
SEED_DEV_PASSWORD=local-dev-password

# --- Shadowed production secrets (leave blank) ----------------------------
# Blank means the feature degrades to its documented "not enabled" path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Blank: magic links and all outbound email print to the dev console.
RESEND_API_KEY=
EMAIL_FROM="Alpha Workspace local <local@example.invalid>"
# Blank: extraction uses the heuristic parser, narratives use templates.
ANTHROPIC_API_KEY=
# Blank: attachments and meeting audio show "not enabled".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPGRAM_API_KEY=
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:local@example.invalid
OPERATOR_EMAILS=lerato@mzansi.studio

# --- PayFast: sandbox, never live -----------------------------------------
# PayFast's public sandbox credentials. Do not paste the live ones here.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=true
PAYFAST_PRORATION=false
