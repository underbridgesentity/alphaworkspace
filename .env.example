# Copy to .env.local and fill in. Server-only secrets never reach the browser;
# only NEXT_PUBLIC_* values are exposed to the client.

# --- Core ---------------------------------------------------------------
# Postgres (Supabase — pick region af-south-1 / Cape Town if available)
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpha
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=
# Protects /api/cron/* endpoints (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# --- Auth providers ------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) -------------------------------------------------------
# Without a key, dev falls back to logging magic links/emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Alpha Workspace <alpha@updates.example.co.za>"

# --- AI (Anthropic, server routes only) -----------------------------------
# Without a key, extraction falls back to the built-in heuristic parser and
# narratives/briefs are composed from templates.
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACTION=claude-haiku-4-5
AI_MODEL_NARRATIVE=claude-sonnet-4-6

# --- Payments (PayFast) ----------------------------------------------------
# Defaults below are PayFast's public sandbox credentials.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_SANDBOX=true

# --- Web push (generate both with: npm run push:keys) ----------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alpha@updates.example.co.za

# --- Supabase Storage (attachments + meeting audio) ------------------------
# Without these, attachments and meeting recordings degrade to "not enabled"
# with no other signal, so set both on any real deploy.
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVER ONLY. Bypasses RLS entirely, so never expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
